[Unit]
Description=Curator (send images to a Samsung The Frame)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/curator
ExecStart=/opt/curator/.venv/bin/python -m curator
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
