[Unit]
Description=Curator (send your photos to a Samsung The Frame)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# deploy/install.sh fills in @USER@ and @ROOT@.
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -m curator --config @ROOT@/config/local.toml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

# Limits: Curator only needs to write its data folder and its token file.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/data @ROOT@/config

[Install]
WantedBy=multi-user.target
