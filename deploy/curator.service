[Unit]
Description=Curator (send your photos to a Samsung The Frame)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/curator
ExecStart=/opt/curator/.venv/bin/python -m curator --config /opt/curator/config/local.toml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

# Limits: Curator only needs to write its data folder and its token file.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/curator/data /opt/curator/config

[Install]
WantedBy=multi-user.target
